# Copy an overlay from ANYWHERE in the 2MB ROM into IRAM (words 0x000-0x3FF) and run it.
# Uses a PM read stream (not ((rX)), which only reaches program space 0x0000-0xFFFF).
# Inputs: RAM-A[0] = ROM addr low, RAM-A[1] = ROM mode word (0x08xx, xx = addr bits 16-20), RAM-A[2] = word count
org 400
load_overlay:   ld st, 0x0060
                ld r0, 0x00
                ld a, (r0)
                ld ext6, a                  # PMC low
                ld r0, 0x01
                ld a, (r0)
                ld ext6, a                  # PMC high (mode)
                ld -, ext1                  # program PM1 read + prefetch
                ld ext6, 0x8000
                ld ext6, 0x081C             # IRAM word 0 (0x1C8000), inc 1
                ld ext4, -
                ld r0, 0x02
                ld a, (r0)
                ld y, a
ov_copy:        ld a, ext1
                ld ext4, a
                ld a, y
                subi 0x01
                ld y, a
                bra z=0, @ov_copy
                ld st, 0x0000
                bra always, 0x0000          # jump into IRAM
